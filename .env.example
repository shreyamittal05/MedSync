# Copy this file to .env and fill in your Supabase project's values to
# enable Option A (cloud real-time sync). Leave both blank — or don't
# create .env at all — and the app runs entirely on localStorage plus
# the QR-embedded fallback (Option B), no setup required.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
